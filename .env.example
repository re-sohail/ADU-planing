# Postgres connection string
DATABASE_URL=

# Parcel boundaries (server only) - https://app.regrid.com
REGRID_TOKEN=

# Satellite map tiles - public pk. token from https://account.mapbox.com, restrict to your domain
NEXT_PUBLIC_MAPBOX_TOKEN=

# Address search - Google Cloud key with Maps JavaScript API + Places API (New) enabled, restrict by HTTP referrer
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Email for appointment confirmations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
LEAD_NOTIFY_EMAIL=
